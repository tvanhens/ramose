---
/**
 * Primary lockup: the rounded diamond mark + the wordmark from the supplied
 * brand reference — "ramose." in warm white and "ai" in orange.
 *
 * The mark lives in `src/assets/ramose-mark.svg`; Astro turns an imported SVG
 * into a component, so it inlines (and can be sized) rather than loading an
 * extra request. The outer diamond uses `currentColor`; the inset diamond
 * carries the orange gradient inside the SVG.
 */
import RamoseMark from "../assets/ramose-mark.svg";
---

<a href="/" class="rg-site-title">
  <span class="rg-mark"><RamoseMark aria-hidden="true" /></span>
  <span class="rg-word">ramose.<span class="rg-word-tld">ai</span></span>
</a>

<style>
  .rg-site-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    color: var(--sl-color-white);
    min-width: 0;
  }
  /* The mark renders as a child component, so reach it with :global —
     scoped styles do not cross the component boundary. */
  .rg-mark {
    display: flex;
    flex-shrink: 0;
  }
  /* Pin both axes so the square mark keeps its optical balance in the nav. */
  .rg-mark :global(svg) {
    display: block;
    width: 1.75rem;
    height: 1.75rem;
    filter: drop-shadow(0 0 0.35rem rgba(255, 101, 0, 0.2));
  }
  .rg-word {
    font-weight: 350;
    font-size: 1.2rem;
    letter-spacing: 0.035em;
    white-space: nowrap;
    color: var(--sl-color-white);
  }
  .rg-word-tld {
    color: var(--sl-color-accent);
  }
</style>
