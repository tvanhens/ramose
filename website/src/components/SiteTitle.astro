---
/** Primary lockup: symbol + the product name. The domain lives in the URL. */
---

<a href="/" class="rg-site-title">
  <svg viewBox="0 0 216 94" fill="none" aria-hidden="true" class="rg-mark">
    <path
      d="M90.8 61.2 C74.2 82.5 60 88 41.8 85.7 C16.5 82.5 3.9 63.6 5.5 42.2 C7.1 19.3 23.6 5.1 45.7 6.7 C67.9 7.5 80.5 25.7 95.5 41.4 C111.3 57.2 128.7 71.4 148.4 80.1 C170.5 89.6 188.7 84.1 199.7 69.1 C212.4 51.7 207.6 28 191.8 17 C174.5 4.3 150 5.1 131 17.8 C126.3 20.9 122.3 24.1 119.2 27.2"
      stroke="currentColor"
      stroke-width="7.9"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <path
      d="M135 37.5 C148.4 28 169.7 26.4 182.4 39.9"
      stroke="currentColor"
      stroke-width="7.9"
      stroke-linecap="round"></path>
  </svg>
  <span class="rg-word">Ripple</span>
</a>

<style>
  .rg-site-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    color: var(--sl-color-white);
    min-width: 0;
  }
  .rg-mark {
    height: 1.375rem;
    width: auto;
    flex-shrink: 0;
  }
  .rg-word {
    font-weight: 600;
    font-size: var(--sl-text-lg);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
</style>
