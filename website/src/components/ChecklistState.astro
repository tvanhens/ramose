<script>
  const scope = document.querySelector(".sl-markdown-content");
  const boxes = scope
    ? Array.from(scope.querySelectorAll('li > input[type="checkbox"]'))
    : [];

  if (boxes.length > 0) {
    const KEY = "ramose:checklist:" + location.pathname;

    let saved = {};
    try {
      saved = JSON.parse(localStorage.getItem(KEY) || "{}") || {};
    } catch {
      saved = {};
    }

    const seen = new Map();
    for (const box of boxes) {
      let node = box.closest("ul, ol");
      let section = "top";
      while (node) {
        node = node.previousElementSibling;
        if (!node) break;

        const h = node.matches("h2, h3")
          ? node
          : node.querySelector(":scope > h2, :scope > h3");
        if (h) {
          section = h.id || "top";
          break;
        }
      }
      const n = seen.get(section) || 0;
      seen.set(section, n + 1);
      box.dataset.key = section + ":" + n;

      box.disabled = false;
      box.checked = saved[box.dataset.key] === true;
      const item = box.parentElement;
      const strong = item && item.querySelector("strong");
      const name = strong
        ? strong.textContent
        : ((item && item.textContent) || "").trim().slice(0, 80);
      if (name) box.setAttribute("aria-label", name);
    }

    const note = document.createElement("p");
    note.className = "rg-checklist-note";
    const count = document.createElement("span");
    const reset = document.createElement("button");
    reset.type = "button";
    reset.textContent = "Clear";
    note.append(count, document.createTextNode(" · this browser remembers "), reset);

    const learn = scope.querySelector(".rg-learn");
    if (learn) learn.after(note);
    else {
      const firstList = boxes[0].closest("ul, ol");
      firstList.parentNode.insertBefore(note, firstList);
    }

    const render = () => {
      const done = boxes.filter((b) => b.checked).length;
      count.textContent = done + " of " + boxes.length + " done";
      reset.hidden = done === 0;
    };

    const save = () => {
      const state = {};
      for (const box of boxes) if (box.checked) state[box.dataset.key] = true;
      try {
        localStorage.setItem(KEY, JSON.stringify(state));
      } catch {}
      render();
    };

    reset.addEventListener("click", () => {
      for (const box of boxes) box.checked = false;
      save();
    });

    for (const box of boxes) box.addEventListener("change", save);
    render();
  }
</script>
