---
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { resolveShotCode } from "../../scripts/lib/snippets.mjs";

// The only way to put an image on a page. See blueprint §1.5.
// `code` is a repo-relative path with a `#marker` or `:a-b` range; it
// becomes a GitHub blob link at master (#La-Lb) and is shown without
// "examples/reef/".
interface Props {
  src: string;
  alt: string;
  /** Optional: real dimensions are read from the file at build time. */
  width?: number;
  height?: number;
  caption?: string;
  code?: string;
  eager?: boolean;
  class?: string;
}

const {
  src,
  alt,
  width: widthProp,
  height: heightProp,
  caption,
  code,
  eager = false,
  class: cls = "",
} = Astro.props;

// Real pixel dimensions, read from the file in `public/` at build time, so a
// figure always reserves the right box and never shifts the layout. Falls back
// to the props (then to a 16:9 box) if the file cannot be measured.
const measure = (file: string): { w: number; h: number } | undefined => {
  try {
    const buf = readFileSync(fileURLToPath(new URL(`../../public${file}`, import.meta.url)));
    // PNG: IHDR width/height are big-endian uint32 at bytes 16 and 20.
    if (buf.length > 24 && buf.readUInt32BE(0) === 0x89504e47) {
      return { w: buf.readUInt32BE(16), h: buf.readUInt32BE(20) };
    }
    // GIF: logical screen width/height are little-endian uint16 at bytes 6 and 8.
    if (buf.length > 10 && buf.toString("ascii", 0, 3) === "GIF") {
      return { w: buf.readUInt16LE(6), h: buf.readUInt16LE(8) };
    }
  } catch {
    // fall through to the props
  }
  return undefined;
};

const real = measure(src);
const width = real?.w ?? widthProp ?? 1600;
const height = real?.h ?? heightProp ?? 900;

let gh: string | undefined;
let short: string | undefined;
if (code) {
  const resolved = resolveShotCode(code);
  if (resolved && !resolved.error) {
    gh = resolved.gh;
    short = resolved.short;
  }
}
---

<figure class={`rg-shot${cls ? ` ${cls}` : ""}`}>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={eager ? "high" : undefined}
    style={`max-width:min(100%,${width}px)`}
  />
  {
    (caption || code) && (
      <figcaption>
        {caption}
        {code && (
          <>
            {caption && " · "}
            <a href={gh}>
              <code>{short}</code>
            </a>
          </>
        )}
      </figcaption>
    )
  }
</figure>
