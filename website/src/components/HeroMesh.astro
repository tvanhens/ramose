<canvas
  class="rg-hero-mesh"
  data-hero-mesh
  aria-hidden="true"
></canvas>

<script>
  import { startHeroParticles } from "./hero-particles";

  async function startMesh(canvas: HTMLCanvasElement) {
    if (canvas.dataset.meshState || matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }

    canvas.dataset.meshState = "loading";
    const hero = canvas.closest<HTMLElement>(".rg-proto-hero");
    if (!hero || !("gpu" in navigator)) {
      canvas.dataset.meshState = "fallback";
      return;
    }

    try {
      const particles = await startHeroParticles(canvas, hero, {
        onLost: (reason) => {
          canvas.dataset.meshState = "fallback";
          hero.classList.remove("rg-mesh-ready");
          console.warn("Ramose hero mesh fell back to its static artwork.", reason);
        },
      });
      if (!canvas.isConnected) {
        particles.stop();
        return;
      }

      canvas.dataset.meshState = "ready";
      hero.classList.add("rg-mesh-ready");
      document.addEventListener("astro:before-swap", particles.stop, { once: true });
    } catch (error) {
      canvas.dataset.meshState = "fallback";
      console.warn("Ramose hero mesh fell back to its static artwork.", error);
    }
  }

  document.querySelectorAll<HTMLCanvasElement>("[data-hero-mesh]").forEach((canvas) => {
    void startMesh(canvas);
  });
</script>
