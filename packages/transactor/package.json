{
  "name": "@ramose/transactor",
  "version": "0.1.0",
  "type": "module",
  "description": "Ramose Transactor Durable Object: single writer per database, group commit, novelty WebSocket hub, alarm-driven incremental indexer + GC.",
  "license": "Apache-2.0",
  "author": "Tyler van Hensbergen <tvanhens@gmail.com>",
  "homepage": "https://ramose.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tvanhens/ripple.git",
    "directory": "packages/transactor"
  },
  "bugs": {
    "url": "https://github.com/tvanhens/ripple/issues"
  },
  "keywords": [
    "ramose",
    "database",
    "cloudflare",
    "durable-objects",
    "transactor"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "bun": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.ts": {
      "bun": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "bun": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test"
  },
  "dependencies": {
    "@ramose/core": "workspace:*",
    "@ramose/storage": "workspace:*"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.105"
  }
}
