{
  "name": "@ramose/alchemy",
  "version": "0.1.1",
  "type": "module",
  "description": "Alchemy 2 + Effect interface for Ramose: the portable `@ramose/alchemy/db` entry, the Ramose.Server and Ramose.Database resources, the ReadWriteDatabases / ReadDatabases capabilities and the ServerBinding / ServerHttp transports.",
  "license": "Apache-2.0",
  "author": "Tyler van Hensbergen <tvanhens@gmail.com>",
  "homepage": "https://ramose.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tvanhens/ramose.git",
    "directory": "packages/alchemy"
  },
  "bugs": {
    "url": "https://github.com/tvanhens/ramose/issues"
  },
  "keywords": [
    "ramose",
    "database",
    "alchemy",
    "cloudflare",
    "effect",
    "infrastructure-as-code"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./db": {
      "bun": "./src/db/index.ts",
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./*.js": {
      "bun": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.ts": {
      "bun": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "bun": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test"
  },
  "dependencies": {
    "@ramose/core": "workspace:*"
  },
  "peerDependencies": {
    "@ramose/worker": "workspace:*",
    "alchemy": ">=2.0.0-beta.72",
    "effect": ">=4.0.0-beta.105"
  },
  "peerDependenciesMeta": {
    "@ramose/worker": {
      "optional": true
    }
  }
}
