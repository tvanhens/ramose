{
  "name": "@ramose/worker",
  "version": "0.1.0",
  "type": "module",
  "description": "Ramose peer Worker: HTTP API (/transact /query /pull /db-info), datalog at the edge over cached segments + replica novelty; exports the DO classes.",
  "license": "Apache-2.0",
  "author": "Tyler van Hensbergen <tvanhens@gmail.com>",
  "homepage": "https://ramose.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tvanhens/ramose.git",
    "directory": "packages/worker"
  },
  "bugs": {
    "url": "https://github.com/tvanhens/ramose/issues"
  },
  "keywords": [
    "ramose",
    "database",
    "cloudflare",
    "workers",
    "datalog",
    "edge"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "bun": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.ts": {
      "bun": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "bun": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test"
  },
  "dependencies": {
    "@ramose/core": "workspace:*",
    "@ramose/replica": "workspace:*",
    "@ramose/storage": "workspace:*",
    "@ramose/transactor": "workspace:*",
    "jose": "^6.0.0"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.105"
  }
}
