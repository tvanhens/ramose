{
  "name": "@ramose/storage",
  "version": "0.1.0",
  "type": "module",
  "description": "Ramose storage adapters for Cloudflare: R2-backed content-addressed node store (memory → Cache API / SQLite → R2), root records, log chunks.",
  "license": "Apache-2.0",
  "author": "Tyler van Hensbergen <tvanhens@gmail.com>",
  "homepage": "https://ramose.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tvanhens/ramose.git",
    "directory": "packages/storage"
  },
  "bugs": {
    "url": "https://github.com/tvanhens/ramose/issues"
  },
  "keywords": [
    "ramose",
    "database",
    "cloudflare",
    "r2",
    "storage"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "bun": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.ts": {
      "bun": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "bun": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test"
  },
  "dependencies": {
    "@ramose/core": "workspace:*"
  }
}
