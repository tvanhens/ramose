{
  "name": "@ramose/replica",
  "version": "0.1.0",
  "type": "module",
  "description": "Ramose QueryReplica Durable Object: long-lived novelty subscriber (WS to the Transactor), hot-segment cache, basis/novelty endpoint for Workers.",
  "license": "Apache-2.0",
  "author": "Tyler van Hensbergen <tvanhens@gmail.com>",
  "homepage": "https://ramose.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tvanhens/ramose.git",
    "directory": "packages/replica"
  },
  "bugs": {
    "url": "https://github.com/tvanhens/ramose/issues"
  },
  "keywords": [
    "ramose",
    "database",
    "cloudflare",
    "durable-objects",
    "replica"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "bun": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.ts": {
      "bun": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "bun": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test"
  },
  "dependencies": {
    "@ramose/core": "workspace:*",
    "@ramose/storage": "workspace:*",
    "@ramose/transactor": "workspace:*"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.105"
  }
}
